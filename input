&setup
    trj = 0 50 10000 50
    stationary = 1
/
&pot_param
    eta_const   = 10d30 
    sigma_const = 1.d0
    gamma_const = 0.0d0
    kappa_const = 1.d0
/
&inp_mass
    masses = 1.d0 1.d0 
/
&equilibrium
    ceq(1) = (1.d0,0.d0)
    ceq(2) = (0.d0,0.d0)
    ceq(3) = (0.d0,0.d0)
    Beq(1,1) = (1.d0,0.0d0)
    Beq(1,2) = (0.d0,0.d0)
    Beq(2,2) = (1.d0,0.d0)
    Beq(2,1) = (0.0d0,0.0d0)
    qeq(1) = 0.d0
    qeq(2) = 0.d0
    peq(1) = 1.d0
    peq(2) = 0.d0
/
&initial
    p0(1) = 0.d0
/
&grid
    lwb = -120.d0
    hgb = 120.d0
    gstep = 10000
/
&scaling_factors
    scalv = 200.d0 300.d0
    scalm = 10.d0 30.d0
            20.d0 40.d0 
/
