<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># 2D GAUSSIAN
rvec:=Vector(2,[x-q,y-Q]):
A:=Matrix(2,2,symbol='a',shape=symmetric):
DG:=exp(-Transpose(rvec).A.rvec/2):
start_sub:={q=-2.0000000000000000,Q=0.20000000000000001,A[1,1]=0.56000000000000005,A[1,2]=0.20000000000000001+I*0.29999999999999999,A[2,2]=2.0000000000000000+I*4.0000000000000000};
Hvec:=Vector(3,[HermiteH(0,sqrt(Re(A[1,1]))*(x-q))/sqrt(factorial(0)*2^0),HermiteH(1,sqrt(Re(A[1,1]))*(x-q))/sqrt(factorial(1)*2^1),HermiteH(2,sqrt(Re(A[1,1]))*(x-q))/sqrt(factorial(2)*2^2)]):
simplify(Hvec):
