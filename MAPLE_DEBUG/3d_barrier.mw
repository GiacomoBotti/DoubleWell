<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># POTENTIAL PARAMETERS
g:=0.1; # coupling constant
eta:=1.3544; # quartic constant
sigma:=-1; # x quadratic constant
kappa:= 1; # y quadratic constant
#kappa_b:= 0.2; # y coupling constant
