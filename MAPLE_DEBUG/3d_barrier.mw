<Group hide-input="false" labelreference="L3208" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ITERATE OVER COUPLING
barrier:=[];
couplings:=[0.0,0.2,0.4,0.6,0.8,0.9,0.95,1.0,1.05,1.1,1.2,1.4,1.6];
for skappa in couplings do:
   minima,points:=minimize(subs(kappa_b=skappa,V),location):
   for i in points do print(['x','y','z']=subs(i[1],[x,y,z])); od;
   Height_Bat:=subs({x=0,y=0,z=0},V)-subs(points[1][1],subs(kappa_b=skappa,V));
   barrier:=[op(barrier),[skappa,Height_Bat]]:
od:
print(barrier);   </Text-field>
