<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># COMPUTE INITIAL COHERENT WIDTH MATRIX</Text-field>
</Input>
</Group>
<Group labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart;
with(LinearAlgebra):
with(VectorCalculus):</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># DEFINE THE POTENTIAL
eta:=1.3544;
sigma:=-1;
c:=0.1;
kappa:=1;
<Font opaque="true" background="[255,255,0]">epsilon:=0.5;</Font>
V:=x^4/16/eta + sigma*x^2/2 + kappa*y^2/2 + kappa*z^2/2 +c*x*y +epsilon*y*z;</Text-field>
</Input>
