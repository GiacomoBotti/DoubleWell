<Group hide-input="false" labelreference="L1769" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># COMPARISON WITH NH3
# Dutra2020a parameters
b2:=-0.03139;
b4:=0.02875;
delta:=0.1893;
upsilon:=0.007181;
massy:=3671;
massx:=5508;
VNH3_nomass:=b2*x^2 + b4*x^4 + delta*x*y + upsilon*y^2/2:
VNH3:=evalf(subs({x=sqrt(massx)*x,y=sqrt(massy)*y},VNH3_nomass));
VNH3:=VNH3_nomass;
contourplot(VNH3,x=-0.2..0.2,y=-6..6,contours=12,filled);
gradVNH3:=Vector(2);
gradVNH3[1]:=diff(VNH3,x);
gradVNH3[2]:=diff(VNH3,y);
minimaNH3,pointsNH3:=minimize(VNH3,location);
for i in pointsNH3 do ['x','y']=subs(i[1],[x,y]); od</Text-field>
</Input>
