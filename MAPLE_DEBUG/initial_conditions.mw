<Group hide-input="false" labelreference="L5" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># MINIMA
gradV:=Vector(2);
gradV[1]:=diff(V,x);
gradV[2]:=diff(V,y);
minima,points:=minimize(V,location):
