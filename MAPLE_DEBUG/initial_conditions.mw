<Group hide-input="false" labelreference="L1679" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># FREQUENCIES
ddVx:=subs(points[1][1],diff(V,x$2));
ddVy:=subs(points[1][1],points[2][1],diff(V,y$2));
omega_x:=sqrt(ddVx);
omega_y:=sqrt(ddVy);
ZPE:=(omega_x+omega_y)/2;
p1,p2:=solve(0.5*(1+g^2)*x^2=ZPE);
p0:=Vector(2,[p1,-g*p1]);
ZPE-Transpose(p0).p0/2;</Text-field>
</Input>
