</Output>
</Group>
<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Time derivative
dotB:=-I*B.M.B;
dotB_sigma:=dotB*~Sigma;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Time propagated B
Bt:=B+t*dotB;
Bt_sigma:=B+t*dotB_sigma;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L5" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Inverse B derivative
invdotB:=simplify(-MatrixInverse(B).dotB.MatrixInverse(B));
invdotB_sigma:=simplify(-MatrixInverse(B).dotB_sigma.MatrixInverse(B)):
invdotB_sigma_2:=simplify(-MatrixInverse(B).dotB.MatrixInverse(B)*~Sigma);
invdotB_sigma_ihope:=I*M*~Sigma;
invdotB_invSigma:=I*M*~MatrixInverse(Sigma);
</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L6" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Time propagated inverse B
invBt_nosigma:=simplify(MatrixInverse(B) + t*invdotB):
invBt:=simplify(MatrixInverse(B) + t*invdotB_sigma_ihope):
invBt_2:=simplify(MatrixInverse(B) + t*invdotB_invSigma):
Bt_vtv_nosigma:=MatrixInverse(invBt_nosigma):
print(Bt_vtv_nosigma(1,1));
Bt_vtv:=expand(simplify(expand(MatrixInverse(invBt)))):
print(simplify(Bt_vtv(1,1)));
Bt_vtv_2:=simplify(MatrixInverse(invBt_2)):
Bt_vtv_3:=simplify(expand(MatrixInverse(invBt_nosigma)*~Sigma)):</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
