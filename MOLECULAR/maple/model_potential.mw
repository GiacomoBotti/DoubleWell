<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 8. Generate scan points
#
# Here I use the tight scan interval:
#
#       1.00 -- 1.25 Angstrom
#       step = 0.01 Angstrom
#
# Change these three numbers if desired.
# ============================================================

rmin := 1.00:
rmax := 1.25:
dr := 0.01:
npoints := round((rmax-rmin)/dr):

r_scan := [seq(evalf(rmin + i*dr), i=0..npoints)]:

<Font encoding="UTF-8">printf(&quot;\134nNumber of scan points = %d\134n&quot;, nops(r_scan)):
