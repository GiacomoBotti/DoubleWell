<Group labelreference="L107" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">#==============================================================
# PRINT FOR FORTRAN
#==============================================================
<Font encoding="UTF-8">printf(&quot;\134n# Width matrix Beq\134n&quot;):
</Font>
for i from 1 to 5 do
    for j from 1 to 5 do

        val := evalf(Re(Hsqrt[i,j])):

        str := sprintf(&quot;%.16e&quot;, val):
        str := StringTools:-SubstituteAll(str, &quot;e&quot;, &quot;d&quot;):

        printf(
<Font encoding="UTF-8">            &quot;Beq(%d,%d) = (%s,0.d0),\134n&quot;,
</Font>            i, j, str
        ):

    end do:
end do:
<Font encoding="UTF-8">printf(&quot;\134n# Initial momentum p0\134n&quot;):
</Font>
for i from 1 to 5 do

    val := evalf(Re(p0[i])):

    str := sprintf(&quot;%.16e&quot;, val):
    str := StringTools:-SubstituteAll(str, &quot;e&quot;, &quot;d&quot;):

    printf(
<Font encoding="UTF-8">        &quot;peq(%d) = %s,\134n&quot;,
</Font>        i, str
    ):

end do:</Text-field>
</Input>
