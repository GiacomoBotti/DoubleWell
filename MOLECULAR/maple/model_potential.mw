<Group labelreference="L106" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# Energy check
# ============================================================

E_normal := evalf(
    0.5*DotProduct(Pnormal,Pnormal)
):

E_chain := evalf(
    0.5*DotProduct(p0,p0)
):

printf(
<Font encoding="UTF-8">    &quot;\134nTotal excitation energy, normal basis = %.12e Eh\134n&quot;,
</Font>    Re(E_normal)
):

printf(
<Font encoding="UTF-8">    &quot;Total excitation energy, chain basis  = %.12e Eh\134n&quot;,
</Font>    Re(E_chain)
):</Text-field>
</Input>
