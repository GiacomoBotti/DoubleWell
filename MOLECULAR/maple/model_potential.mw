<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 5. Relaxed harmonic curvature
#
# Minimizing over y gives
#
# V_rel,harm(x)
#     = 1/2 [sigma - gamma^2 (K^-1)_11] x^2
# ============================================================

krel := sigma - gamma1^2*Kinv11:

<Font encoding="UTF-8">printf(&quot;\134nBare system curvature sigma = %g\134n&quot;, sigma):
printf(&quot;Relaxed curvature krel       = %g\134n&quot;, krel):
</Font>
freq_rel_cm := sqrt(krel)*cm1_per_au:

<Font encoding="UTF-8">printf(&quot;Relaxed harmonic frequency = %12.6f cm^-1\134n&quot;,
</Font>       freq_rel_cm):</Text-field>
</Input>
