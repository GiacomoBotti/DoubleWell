<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# Transform initial conditions to Lanczos coordinates
# ============================================================

q0 := Re(evalf(U.Qnormal)):

p0 := evalf(U.Pnormal):

<Font encoding="UTF-8">printf(&quot;\134nInitial coordinates in Lanczos basis:\134n&quot;):
</Font>
for i to 5 do
    printf(
<Font encoding="UTF-8">        &quot;q0[%d] = % .12e\134n&quot;,
</Font>        i,
        q0[i]
    ):
end do:

<Font encoding="UTF-8">printf(&quot;\134nInitial momenta in Lanczos basis:\134n&quot;):
</Font>
for i to 5 do
    printf(
<Font encoding="UTF-8">        &quot;p0[%d] = % .12e\134n&quot;,
</Font>        i,
        evalf(Re(p0[i]))
    ):
end do:</Text-field>
</Input>
