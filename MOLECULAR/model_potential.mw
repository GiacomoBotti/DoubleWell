<Group labelreference="L7" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 6. Relaxed quartic model
#
# V_rel(x) =
#     x^4/(16*eta) + 1/2*krel*x^2
#
# This is the energy relative to the equilibrium minimum.
# ============================================================

Vrel := x -&gt; x^4/(16*eta) + krel*x^2/2:</Text-field>
</Input>
</Group>
<Group labelreference="L8" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 7. Conversion from C-H distance to mass-weighted coordinate
#
# x = sqrt(mu) * (r - re)
#
# r is supplied in Angstrom.
# x is in sqrt(me) * bohr.
# ============================================================

# Masses in atomic mass units
mC_u := 12.011:
mH_u := 1.00784:

mu_u := mC_u*mH_u/(mC_u + mH_u):

# 1 u = 1822.88848621 me
u_to_me := 1822.88848621:

mu := mu_u*u_to_me:

# Angstrom -&gt; bohr
angstrom_to_bohr := 1.88972612546:

# Equilibrium C-H distance
re_A := 1.12339224:

<Font encoding="UTF-8">printf(&quot;\134nReduced mass = %12.8f u\134n&quot;, mu_u):
printf(&quot;Reduced mass = %12.8f me\134n&quot;, mu):
printf(&quot;Equilibrium r = %12.8f Angstrom\134n&quot;, re_A):
</Font>

x_of_r := r -&gt;
    sqrt(mu) * (r - re_A) * angstrom_to_bohr:</Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">
Reduced mass =   0.92981911 u
Reduced mass = 1694.95655200 me
Equilibrium r =   1.12339224 Angstrom
</Text-field>
</Output>
</Group>
<Group labelreference="L9" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 8. Generate scan points
#
# Here I use the tight scan interval:
#
#       1.00 -- 1.25 Angstrom
#       step = 0.01 Angstrom
#
# Change these three numbers if desired.
# ============================================================

rmin := 1.00:
rmax := 1.25:
dr := 0.01:
npoints := round((rmax-rmin)/dr):

r_scan := [seq(evalf(rmin + i*dr), i=0..npoints)]:

<Font encoding="UTF-8">printf(&quot;\134nNumber of scan points = %d\134n&quot;, nops(r_scan)):
printf(&quot;First point = %.8f Angstrom\134n&quot;, r_scan[1]):
printf(&quot;Last point  = %.8f Angstrom\134n&quot;, r_scan[-1]):</Font></Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">
Number of scan points = 26
First point = 1.00000000 Angstrom
Last point  = 1.25000000 Angstrom
</Text-field>
</Output>
