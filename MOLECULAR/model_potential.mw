<Group hide-input="false" labelreference="L17" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"><Font encoding="UTF-8"># ============================================================
# 16. Quadratic interpolation around scan minimum
# ============================================================

rr := 'rr':

i_near := 1:
dmin := abs(orca_data[1][1] - re_A):

for i from 2 to nops(orca_data) do
    d := abs(orca_data[i][1] - re_A):

    if d &lt; dmin then
        dmin := d:
        i_near := i:
    end if:
end do:

i1 := i_near-1:
i2 := i_near:
i3 := i_near+1:

r1 := orca_data[i1][1]:
r2 := orca_data[i2][1]:
r3 := orca_data[i3][1]:

E1 := orca_data[i1][2]:
E2 := orca_data[i2][2]:
E3 := orca_data[i3][2]:

# Construct the unique quadratic passing through the 3 points
a, b, c := 'a', 'b', 'c':

eq1 := a*r1^2 + b*r1 + c = E1:
eq2 := a*r2^2 + b*r2 + c = E2:
eq3 := a*r3^2 + b*r3 + c = E3:

abc := solve({eq1,eq2,eq3}, {a,b,c}):

p := subs(abc, a*rr^2 + b*rr + c):

# Minimum of quadratic: dp/dr = 0
r_scan_min := solve(diff(p,rr)=0, rr):

E_scan_min := evalf(subs(rr=r_scan_min,p)):

printf(&quot;Scan minimum r = %.10f Angstrom\134n&quot;,
       evalf(r_scan_min)):

printf(&quot;Scan minimum E = %.12f Hartree\134n&quot;,
       evalf(E_scan_min)):</Font></Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">Scan minimum r = 1.1231836860 Angstrom
Scan minimum E = -69.139261980000 Hartree
</Text-field>
</Output>
</Group>
