<Group labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:

with(LinearAlgebra):
with(plots):</Text-field>
</Input>
</Group>
<Group labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 1. Model parameters
# ============================================================

# All coefficients are in atomic units.
# Coordinates x,y_i are in sqrt(me) * bohr.

eta := 1.72e6:

sigma := 1.57544962e-4:
gamma1 := 2.21864154e-6:

gamma2 := 2.76109459e-5:
gamma3 := 7.68629295e-5:
gamma4 := 1.56842605e-5:

delta1 := 2.87260443e-5:
delta2 := 1.40109428e-4:
delta3 := 8.54424711e-5:
delta4 := 3.12946454e-5:
</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 2. Harmonic Hessian of the 5D model
#
# Coordinates:
#     [x, y1, y2, y3, y4]
#
# V_harm =
#     sigma*x^2/2
#   + gamma1*x*y1
#   + gamma2*y1*y2
#   + gamma3*y2*y3
#   + gamma4*y3*y4
#   + delta1*y1^2/2 + ... + delta4*y4^2/2
# ============================================================

H := Matrix([
    [sigma,  gamma1,   0,       0,       0],
    [gamma1,  delta1,  gamma2,  0,       0],
    [0,      gamma2,  delta2,  gamma3,  0],
    [0,      0,       gamma3,  delta3,  gamma4],
    [0,      0,       0,       gamma4,  delta4]
]):

H := evalf(H):

<Font encoding="UTF-8">printf(&quot;Model Hessian:\134n&quot;):
</Font>print(H):</Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">Model Hessian:
</Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 3. Diagonalize the Hessian
# ============================================================

lambda := Eigenvalues(H):


cm1_per_au := 219474.6313705:

<Font encoding="UTF-8">printf(&quot;\134nModel harmonic frequencies (cm^-1):\134n&quot;):
</Font>
for i from 1 to RowDimension(lambda) do
    freq := sqrt(evalf(Re(lambda[i]))) * cm1_per_au:
<Font encoding="UTF-8">    printf(&quot;  %12.6f\134n&quot;, freq):
</Font>end do:</Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">
Model harmonic frequencies (cm^-1):
   2755.084644
   3087.257064
   1561.501550
    673.120514
   1153.929741
</Text-field>
</Output>
</Group>
<Group labelreference="L5" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 4. Bath matrix K
# ============================================================

K := Matrix([
    [delta1, gamma2, 0,      0],
    [gamma2, delta2, gamma3, 0],
    [0,      gamma3, delta3, gamma4],
    [0,      0,      gamma4, delta4]
]):

K := evalf(K):

e1 := Vector([1, 0, 0, 0]):

z := LinearSolve(K, e1):

Kinv11 := evalf(z[1]):

<Font encoding="UTF-8">printf(&quot;\134n(K^(-1))_11 = %.12e\134n&quot;, Kinv11):
</Font>
krel := evalf(sigma - gamma1^2*Kinv11):

<Font encoding="UTF-8">printf(&quot;Bare system curvature sigma = %.12e\134n&quot;, sigma):
printf(&quot;Relaxed curvature krel       = %.12e\134n&quot;, krel):
</Font>
freq_rel_cm :=
    evalf(sqrt(krel) * cm1_per_au):

<Font encoding="UTF-8">printf(&quot;Relaxed harmonic frequency = %.6f cm^-1\134n&quot;,
</Font>       freq_rel_cm):</Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">
(K^(-1))_11 = 5.950108446127e+04
Bare system curvature sigma = 1.575449620000e-04
Relaxed curvature krel       = 1.572520756300e-04
Relaxed harmonic frequency = 2752.216040 cm^-1
</Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L6" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 5. Relaxed harmonic curvature
#
# Minimizing over y gives
#
# V_rel,harm(x)
#     = 1/2 [sigma - gamma^2 (K^-1)_11] x^2
# ============================================================

krel := sigma - gamma1^2*Kinv11:

<Font encoding="UTF-8">printf(&quot;\134nBare system curvature sigma = %g\134n&quot;, sigma):
printf(&quot;Relaxed curvature krel       = %g\134n&quot;, krel):
</Font>
freq_rel_cm := sqrt(krel)*cm1_per_au:

<Font encoding="UTF-8">printf(&quot;Relaxed harmonic frequency = %12.6f cm^-1\134n&quot;,
</Font>       freq_rel_cm):</Text-field>
</Input>
<Output><Text-field style="Line Printed Output" layout="Line Printed Output">
