<Group hide-input="false" labelreference="L10" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ============================================================
# 9. Generate model energies
#
# Energy is measured relative to the minimum:
#
#       Delta E_model(r) = V_rel(x(r))
#
# Convert Hartree -&gt; eV for easier comparison with an energy
# profile plotted in eV.
# ============================================================

r_scan[1]:
r_scan[2]:
r_scan[26]:

Eh_to_eV := 27.211386245988:

model_data := []:

for i from 1 to nops(r_scan) do

    r := r_scan[i]:

    xval := x_of_r(r):

    E_au := Vrel(xval):
    E_eV := E_au * Eh_to_eV:

    model_data :=
        [op(model_data), [r, xval, E_au, E_eV]]:

end do:</Text-field>
</Input>
</Group>
